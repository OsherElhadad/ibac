FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY finance-agent/ finance-agent/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -o /finance-agent ./finance-agent/

FROM alpine:3.19
COPY --from=builder /finance-agent /finance-agent
EXPOSE 8080
CMD ["/finance-agent"]
