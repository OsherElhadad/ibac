FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY sidecar/ sidecar/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -o /sidecar ./sidecar/

FROM alpine:3.19
COPY --from=builder /sidecar /sidecar
COPY sidecar/intent_prompt.txt /intent_prompt.txt
EXPOSE 9090
USER 1001
CMD ["/sidecar"]
