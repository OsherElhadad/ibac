# Build context: ibac/ (one level above ce-demo/), so we can COPY both
# ce-demo/ce-observer/ and the shared internal/ package + go.mod.
# Usage:
#   podman build -t localhost/ibac-ce-observer:latest \
#       -f ibac/ce-demo/dockerfiles/Dockerfile.ce-observer ibac
FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY ce-demo/ce-observer/ ce-observer/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -o /ce-observer ./ce-observer/

FROM alpine:3.19
COPY --from=builder /ce-observer /ce-observer
EXPOSE 7070
CMD ["/ce-observer"]
