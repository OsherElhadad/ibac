# Copy to .env and fill in your IBM watsonx credentials.
# The ce-proxy reads these either from the kubectl secret `ce-watsonx`
# (when the cluster is running) or from this file (fresh-machine path).

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional: override the model ids. Defaults are fine for the demo.
# WATSONX_MODEL=watsonx/openai/gpt-oss-120b
# ACCEPTED_MODEL=openai/gpt-oss-120b

# Optional: CE knobs. Defaults are tuned for this demo — change only if
# you know what you're doing.
# CE_MAX_TOKENS=131072
# CE_THRESHOLD_FRAC=0.65
# CE_KEEP_LAST_N_TURNS=2
